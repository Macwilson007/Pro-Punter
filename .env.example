# -----------------------------------------------------------------------------
# Pro Punter - Unified Environment Variables
# -----------------------------------------------------------------------------

# BACKEND SETTINGS
# ----------------
API_FOOTBALL_KEY=your_api_football_key_here
FOOTBALL_DATA_KEY=your_football_data_key_here

# Database
# For local development: leave DATABASE_URL empty to use SQLite
# For production: Use a PostgreSQL connection string (Supabase/Neon)
DATABASE_URL=
DATABASE_PATH=data/pro_punter.db

# Betting Logic
KELLY_MULTIPLIER=0.25

# FRONTEND SETTINGS
# ----------------
# In production (Vercel), this can be /api if using the unified deployment
NEXT_PUBLIC_API_URL=http://localhost:8000
